# Options the "docker" kernel adds on top of safe.config (plan-echo-show-5.md, section 3.1).
#
# Every option below changes symbol CRCs that the binary vendor modules import (measured with
# scripts/bisect-crc.sh: NAMESPACES 281 of 547 probed CRCs, CGROUP_DEVICE/CGROUP_PIDS 360,
# BLK_CGROUP 429, CPUSETS and POSIX_MQUEUE 439, module_layout included). LineageOS's
# mt76x8_wlan.ko therefore refuses to load on this kernel; build-kernel.sh rebuilds the driver
# from source against it and the boot image and rootfs carry that module instead.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CFS_BANDWIDTH=y          # changes kernel/sched/core.o CRCs (wake_up_process, set_user_nice); only needed for --cpus
