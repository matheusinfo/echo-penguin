# Options added to cronos_defconfig for every echo-penguin kernel. Each was checked with
# scripts/bisect-crc.sh and changes none of the symbol CRCs the vendor modules (mt76x8_wlan.ko,
# mt76x8_bt.ko) import, so the "safe" kernel still loads LineageOS's own Wi-Fi driver.
# One option per line; build-kernel.sh checks each survived olddefconfig.
CONFIG_VETH=y
CONFIG_OVERLAY_FS=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_NAT_MASQUERADE_IPV4=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_SQUASHFS=y

# Screen console: the Android kernel has no VT and no framebuffer console, so nothing Linux prints
# reaches the panel. With these, kernel messages and a login terminal show on the screen (mtkfb,
# 480x960 portrait, mounted sideways: rotated at boot with fbcon=rotate). Several fonts so the size
# can be picked with fbcon=font: on the kernel command line.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_10x18=y
CONFIG_FONT_SUN12x22=y
