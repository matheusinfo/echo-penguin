#!/usr/bin/env python3
"""rebootto [bootloader|recovery] — reboot with a MediaTek boot-mode argument, as Android's
`reboot bootloader` does: the kernel's arch_reset marks the mode for LK, which then stays in fastboot
(or boots recovery). The same as TECHO5's Go cmd/rebootto, in Python so this image needs no Go build.

Stops the supervisor (and with it the app) and syncs first; the reboot itself skips init's shutdown,
as the Go tool does."""
import ctypes
import os
import subprocess
import sys
import time

LINUX_REBOOT_MAGIC1 = 0xfee1dead
LINUX_REBOOT_MAGIC2 = 672274793
LINUX_REBOOT_CMD_RESTART2 = 0xA1B2C3D4
SYS_REBOOT_ARM = 88  # __NR_reboot on 32-bit ARM (EABI): this userland is armv7 on an arm64 kernel

arg = sys.argv[1] if len(sys.argv) > 1 else ''
if arg not in ('', 'bootloader', 'recovery'):
    sys.exit('usage: rebootto [bootloader|recovery]')
# The hold file first: init starts techo5-run again within a second of the supervisor's end, and
# without it the wait below ran its 40 s and dockerd could be started again just before the reboot.
os.makedirs('/run/techo5', exist_ok=True)
open('/run/techo5/hold', 'w').close()
subprocess.call(['killall', 'techo5'], stderr=subprocess.DEVNULL)
for _ in range(40):
    if subprocess.call(['pidof', 'techo5'], stdout=subprocess.DEVNULL) != 0:
        break
    time.sleep(1)
subprocess.call(['killall', 'dockerd'], stderr=subprocess.DEVNULL)
time.sleep(3)
os.sync()
libc = ctypes.CDLL(None, use_errno=True)
if not arg:
    os.execvp('reboot', ['reboot'])
r = libc.syscall(SYS_REBOOT_ARM, ctypes.c_uint(LINUX_REBOOT_MAGIC1), ctypes.c_uint(LINUX_REBOOT_MAGIC2),
                 ctypes.c_uint(LINUX_REBOOT_CMD_RESTART2), ctypes.c_char_p(arg.encode()))
if r:
    why = os.strerror(ctypes.get_errno())
    os.remove('/run/techo5/hold')  # no reboot: the supervisor comes back
    sys.exit('reboot: %s' % why)
