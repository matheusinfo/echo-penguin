#!/usr/bin/python3
"""penguin-sound — the speaker, safely.

    penguin-sound beep [HZ [MS [COUNT]]]   a tone (default 880 Hz, 200 ms, once)
    penguin-sound play FILE                an MP3 (mpg123) or a 48 kHz 16-bit stereo WAV; SIGTERM stops it
    penguin-sound say [-v VOICE] [--ready] TEXT...    TEXT spoken (Piper)
    penguin-sound render [-v VOICE] OUT TEXT...       the same into OUT (a WAV), not played
    penguin-sound prepare [-v VOICE] [--keep] TEXT... TEXT's clips made ahead, not played
    penguin-sound volume [PERCENT]         show or set the amplifier volume (0-100)

Playback is the MediaTek AFE's DL1 path, card 0 device 23 (S16_LE, stereo, 48 kHz). Two rules from
TECHO5's docs/hardware.md, both found the hard way on cronos:
  - another AFE PCM node must be held open while device 23 plays: with none, the driver puts its ring
    in the AFE's SRAM and the first copy into it panics the kernel. /dev/snd/pcmC0D1c (an unused
    capture) is held open, unconfigured, for the whole playback.
  - never touch Ext_Speaker_Amp_Switch: on cronos it resets the amplifier, which then stays silent
    until a reboot. Volume goes through the amplifier's own digital volume only.

A third rule, found on this unit (v0.3.0): no sample rate or channel conversion by ALSA's plug
layer. A 22050 Hz mono WAV played through plughw:0,23 underran on every period and left a page of
an unrelated file in the page cache zeroed: most likely kernel memory written by the AFE driver
(the file on disk was intact after a reboot). So what reaches
device 23 is already S16_LE, stereo, 48 kHz: mpg123 decodes MP3 to it, speech is converted to it here,
and a WAV in any other format is refused (convert it, or use MP3).

Only one sound plays at a time: a second one, while another plays, is skipped rather than queued.
SIGTERM stops a playback cleanly (the players first, the held capture node last), which is how
penguin-ui stops the alarm's music.

Speech is Piper's, a neural voice that sounds like a person reading: VOICE is a model in
/data/penguin/voices or /usr/share/piper/voices (default PIPER_VOICE, read from defaults.conf, then
/data/penguin/settings.conf). It is slow on this CPU: some 19 s to load the model, then 2 to 7 s a
phrase. So speech is made of clips, kept: each line of TEXT is one clip, rendered once (all the missing
ones of a call by one Piper run), stored as the speaker takes it (the silence around it trimmed) and
joined when said, with a sentence's pause after a line that ends one and a word's after any other.
prepare renders clips ahead: into /run/penguin/speech, where one not asked for in three hours goes, or
with --keep into /data/penguin/speech, for good (another voice's clips are removed). say renders what
is missing first; say --ready never waits: it says the clips there are, up to the first missing one
(exit status 4 when that is the first). penguin-ui prepares the hours, the minutes and the weather's
sentences (penguin-weather phrases, speech --clips), so a tap on the clock is answered at once, and
renders an alarm's greeting ahead of it. One Piper runs at a time. -e ENGINE is accepted and ignored
(v0.3.1 had espeak-ng's robotic voice as a second engine; its package stays, for the phoneme data
Piper reads).
"""
import fcntl
import hashlib
import json
import math
import os
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import time
import wave
from array import array
from itertools import chain, count, cycle, islice, repeat
from operator import add, floordiv, mul, sub

HOLD = '/dev/snd/pcmC0D1c'
DEVICE = 'hw:0,23'
RUN = '/run/penguin'
RATE = 48000
PLAY_LIMIT = 3600  # s: a stuck player must not hold the speaker forever
APLAY = ['aplay', '-q', '--period-size=768', '--buffer-size=3072']
# Volume controls by amplifier, as the kernel names them (cat /sys/bus/i2c/devices/2-*/name).
VOLUME_CONTROLS = ('Master TAS5805m Playback Volume A',  # TI TAS5805M
                   'Digital Volume A')                    # Maxim MAX98396
MAX98396_SAFE_MODE = 'Speaker Safe Mode A'  # a ~30 dB power cap the MAX98396 comes up with
SETTINGS = ('/etc/penguin/defaults.conf', '/data/penguin/settings.conf')
PIPER_LIMIT = 300  # s without a clip from Piper before it is stopped (the model loads in some 19 s here)
PIPER_BATCH = 10   # clips a Piper run: a long list gives way to another caller between two runs
PIPER = '/usr/local/bin/piper'
VOICES = ('/data/penguin/voices', '/usr/share/piper/voices')
KEEP = '/data/penguin/speech'  # clips kept for good: the hours, the minutes (prepare --keep)
TEMP = RUN + '/speech'         # the others (the weather's sentences), until TEMP_AGE s unused
TEMP_AGE = 3 * 3600
QUIET = 200                    # of 32767: below it a sample is silence (trimmed around a clip)


def amixer(*args, check=False):
    r = subprocess.run(['amixer', '-q', '-D', 'hw:0'] + list(args), capture_output=True, text=True, timeout=5)
    if check and r.returncode:
        raise RuntimeError(r.stderr.strip())
    return r


def control_range(name):
    """(min, max, current) of an integer mixer control, or None when the card has no such control."""
    r = subprocess.run(['amixer', '-D', 'hw:0', 'cget', 'name=' + name], capture_output=True, text=True, timeout=5)
    if r.returncode:
        return None
    lo = hi = cur = None
    for part in r.stdout.replace(',', ' ').split():
        if part.startswith('min='):
            lo = int(part[4:])
        elif part.startswith('max='):
            hi = int(part[4:])
        elif part.startswith('values='):
            cur = int(part[7:])
    return None if hi is None else (lo or 0, hi, cur)


def volume(percent=None):
    for name in VOLUME_CONTROLS:
        rng = control_range(name)
        if rng is None:
            continue
        lo, hi, cur = rng
        if percent is None:
            return round(100 * (cur - lo) / (hi - lo)) if cur is not None else None
        percent = max(0, min(100, int(percent)))
        amixer('cset', 'name=' + name, str(lo + round((hi - lo) * percent / 100)), check=True)
        if name == 'Digital Volume A' and control_range(MAX98396_SAFE_MODE):
            amixer('cset', 'name=' + MAX98396_SAFE_MODE, '0')
        return percent
    raise RuntimeError('no known amplifier volume control on card 0')


def tone(hz, ms, path):
    rate, n = 48000, int(48000 * ms / 1000)
    ramp = max(1, min(n // 4, 480))  # 10 ms fades: no clicks
    frames = bytearray()
    for i in range(n):
        env = min(1.0, i / ramp, (n - i) / ramp)
        v = int(0.25 * 32767 * env * math.sin(2 * math.pi * hz * i / rate))
        frames += struct.pack('<hh', v, v)
    with wave.open(path, 'wb') as w:
        w.setnchannels(2)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(bytes(frames))


def settings():
    values = {}
    for path in SETTINGS:
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                text = f.read()
        except OSError:
            continue
        for line in text.splitlines():
            m = re.match(r'^([A-Z_][A-Z0-9_]*)=("?)(.*?)\2\s*(#.*)?$', line)
            if m:
                values[m.group(1)] = m.group(3)
    return values


def read_wav(path):
    """(channels, rate, samples) of a WAV file, the samples as signed 16-bit: 16-bit PCM as is, 32-bit
    float (Piper's output, which Python's wave module does not read) scaled and clipped."""
    with open(path, 'rb') as f:
        data = f.read()
    if data[:4] != b'RIFF' or data[8:12] != b'WAVE':
        raise RuntimeError('%s: not a WAV file' % path)
    pos, fmt, raw = 12, None, None
    while pos + 8 <= len(data):
        cid, size = data[pos:pos + 4], struct.unpack('<I', data[pos + 4:pos + 8])[0]
        body = data[pos + 8:pos + 8 + size]
        if cid == b'fmt ':
            fmt = struct.unpack('<HHIIHH', body[:16])
            if fmt[0] == 0xfffe and len(body) >= 26:  # WAVE_FORMAT_EXTENSIBLE: the real format follows
                fmt = (struct.unpack('<H', body[24:26])[0],) + fmt[1:]
        elif cid == b'data':
            raw = body
        pos += 8 + size + (size & 1)
    if not fmt or raw is None:
        raise RuntimeError('%s: no format or no data' % path)
    tag, channels, rate, bits = fmt[0], fmt[1], fmt[2], fmt[5]
    if tag == 1 and bits == 16:
        samples = array('h')
        samples.frombytes(raw[:len(raw) - len(raw) % 2])
        if sys.byteorder == 'big':
            samples.byteswap()
    elif tag == 3 and bits == 32:
        floats = array('f')
        floats.frombytes(raw[:len(raw) - len(raw) % 4])
        if sys.byteorder == 'big':
            floats.byteswap()
        clipped = map(max, repeat(-1.0), map(min, repeat(1.0), floats))
        samples = array('h', map(int, map(mul, clipped, repeat(32767.0))))
    else:
        raise RuntimeError('%s: format %d, %d-bit: only 16-bit PCM or 32-bit float' % (path, tag, bits))
    return channels, rate, samples


def convert(channels, rate, samples):
    """16-bit samples as frames of what device 23 takes (S16_LE, stereo, 48 kHz): linear interpolation,
    mono computed once for both sides. Built from map() and itertools, which loop in C: about two
    seconds on the unit for ten seconds of speech (a plain Python loop over the samples took five)."""
    if channels not in (1, 2) or not rate:
        raise RuntimeError('not a mono or stereo WAV')
    n = len(samples) // channels
    n_out = n * RATE // rate
    # Output sample i sits at input position i * rate / RATE: index j and fraction f (in 1/RATE). Both
    # repeat every RATE/g outputs, the index then advanced by rate/g inputs.
    g = math.gcd(rate, RATE)
    p_in, p_out = rate // g, RATE // g
    base_j = [k * rate // RATE for k in range(p_out)]
    base_f = [k * rate % RATE for k in range(p_out)]

    def index(shift=0):
        steps = chain.from_iterable(repeat(c * p_in + shift, p_out) for c in count())
        return islice(map(add, cycle(base_j), steps), n_out)

    out = array('h', bytes(4 * n_out))
    for c in range(channels):
        chan = samples[c::channels]
        chan.extend(chan[-1:] * 2)  # the last sample repeated: index + 1 is always there
        a = list(map(chan.__getitem__, index()))
        b = map(chan.__getitem__, index(1))
        slope = map(floordiv, map(mul, map(sub, b, a), islice(cycle(base_f), n_out)), repeat(RATE))
        conv = array('h', map(add, a, slope))
        for side in ((0, 1) if channels == 1 else (c,)):  # mono: computed once, on both sides
            out[side::2] = conv
    if sys.byteorder == 'big':
        out.byteswap()
    return out.tobytes()


def write_wav(path, frames):
    """Frames in the device's format as a WAV file, written atomically and through to the disk (a
    clip on /data must not come back empty after a power cut)."""
    tmp = '%s.%d.tmp' % (path, os.getpid())
    try:
        with open(tmp, 'wb') as f:
            with wave.open(f, 'wb') as w:
                w.setnchannels(2)
                w.setsampwidth(2)
                w.setframerate(RATE)
                w.writeframes(frames)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def trimmed(channels, rate, samples):
    """The samples without the silence Piper leaves around the speech (20 ms of it kept): the pauses
    between clips are join()'s."""
    n = len(samples)
    first = next((i for i in range(n) if abs(samples[i]) > QUIET), n)
    last = next((i for i in range(n - 1, -1, -1) if abs(samples[i]) > QUIET), -1)
    if last < first:
        return samples
    pad = channels * (rate // 50)
    a, b = max(0, first - pad), min(n, last + 1 + pad)
    return samples[a - a % channels:b + -b % channels]


def wav_format(path):
    """(rate, channels, sample width) of a WAV file; None when it cannot be read as one."""
    try:
        with wave.open(path, 'rb') as w:
            return w.getframerate(), w.getnchannels(), w.getsampwidth()
    except (OSError, EOFError, wave.Error):
        return None


def piper_model(voice):
    """The Piper model file of a voice name (or a path to one), from /data/penguin/voices first."""
    if '/' in voice:
        return voice
    for d in VOICES:
        path = os.path.join(d, voice if voice.endswith('.onnx') else voice + '.onnx')
        if os.path.isfile(path):
            return path
    raise RuntimeError('no Piper voice %s in %s' % (voice, ' or '.join(VOICES)))


def clip(voice, text, keep=False):
    """Where the clip of a text in a voice is kept."""
    name = os.path.basename(voice)
    name = name[:-5] if name.endswith('.onnx') else name
    return os.path.join(KEEP if keep else TEMP, name, hashlib.sha1(text.encode()).hexdigest()[:24] + '.wav')


def cached(voice, text):
    """The clip of a text when there is one, else None."""
    for keep in (True, False):
        path = clip(voice, text, keep)
        try:
            if os.path.getsize(path) > 44:
                return path
        except OSError:
            pass
    return None


def piper(model, texts, done):
    """The texts spoken by one Piper run, the model loaded once: done(text, wav) as each one comes
    (Piper's own WAV: 22050 Hz mono, 16-bit or 32-bit float)."""
    if not os.access(PIPER, os.X_OK):
        raise RuntimeError('Piper is not installed (%s)' % PIPER)
    work = tempfile.mkdtemp(prefix='piper-', dir=RUN)
    try:
        jobs = {os.path.join(work, '%d.wav' % i): t for i, t in enumerate(texts)}
        # JSON lines: a text may start with a dash, and each one names its own file.
        lines = ''.join(json.dumps({'text': t, 'output_file': p}, ensure_ascii=False) + '\n'
                        for p, t in jobs.items())
        with open(os.path.join(work, 'log'), 'w+b') as log:
            p = subprocess.Popen([PIPER, '-m', model, '--json-input'], stdin=subprocess.PIPE,
                                 stdout=subprocess.PIPE, stderr=log, bufsize=0)
            try:
                p.stdin.write(lines.encode())
                p.stdin.close()
                while jobs:  # Piper prints each file's path once it is written
                    if not select.select([p.stdout], [], [], PIPER_LIMIT)[0]:
                        raise RuntimeError('piper: nothing in %d s' % PIPER_LIMIT)
                    line = p.stdout.readline()
                    if not line:
                        break
                    path = line.decode(errors='replace').strip()
                    if path in jobs and os.path.getsize(path) > 44:
                        done(jobs.pop(path), path)
                        os.remove(path)
                rc = p.wait(timeout=30)
            finally:
                if p.poll() is None:
                    p.kill()
                    p.wait()
            if rc or jobs:
                log.seek(0)
                why = log.read().decode(errors='replace').strip().splitlines()
                raise RuntimeError('piper: %s' % (why[-1] if why else 'exit %d, %d clip(s) not made' % (
                    rc, len(jobs))))
    finally:
        shutil.rmtree(work, ignore_errors=True)


def prepare(voice, texts, keep=False):
    """The clips of the texts that have none yet, rendered and stored (for good with keep). One Piper
    at a time on the unit (it takes most of a core and some 200 MB), PIPER_BATCH clips a run."""
    dest = os.path.dirname(clip(voice, '', keep))
    os.makedirs(dest, exist_ok=True)
    texts = list(dict.fromkeys(texts))
    if keep:  # one voice speaks: another one's clips only take room
        for other in os.listdir(KEEP):
            if other != os.path.basename(dest):
                shutil.rmtree(os.path.join(KEEP, other), ignore_errors=True)
    else:  # the clips asked for stay; one nobody asked for in TEMP_AGE s goes
        wanted, now = {os.path.basename(clip(voice, t)) for t in texts}, time.time()
        for name in os.listdir(dest):
            path = os.path.join(dest, name)
            try:
                if name in wanted:
                    os.utime(path)
                elif now - os.path.getmtime(path) > TEMP_AGE:
                    os.remove(path)
            except OSError:
                pass
    missing = [t for t in texts if not cached(voice, t)]
    if not missing:
        return
    model = piper_model(voice)

    def store(text, wav):
        channels, rate, samples = read_wav(wav)
        write_wav(clip(voice, text, keep), convert(channels, rate, trimmed(channels, rate, samples)))

    for i in range(0, len(missing), PIPER_BATCH):
        with open(os.path.join(RUN, 'speech.lock'), 'w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            batch = [t for t in missing[i:i + PIPER_BATCH] if not cached(voice, t)]
            if batch:
                piper(model, batch, store)


def join(voice, texts):
    """The clips of the texts one after the other, as frames: a sentence's pause after a text that
    ends one, a word's after any other (an hour, before its minutes)."""
    out = bytearray()
    for t in texts:
        path = cached(voice, t)
        if not path:
            raise RuntimeError('no clip for "%s"' % t)
        with wave.open(path, 'rb') as w:
            out += w.readframes(w.getnframes())
        out += bytes(4 * int(RATE * (0.35 if t[-1] in '.!?' else 0.06)))
    return bytes(out)


def speech_options(args):
    """(voice, flags, rest) from [-v VOICE] [--ready] [--keep] ..., the voice from the settings when
    not given. -e ENGINE is skipped: v0.3.1's option, when espeak-ng was an engine too."""
    voice, flags = None, set()
    while args and args[0] in ('-e', '-v', '--ready', '--keep'):
        if args[0].startswith('--'):
            flags.add(args[0][2:])
            args = args[1:]
            continue
        if len(args) < 2:
            break
        if args[0] == '-v':
            voice = args[1]
        args = args[2:]
    return voice or settings().get('PIPER_VOICE') or 'pt_BR-faber-medium', flags, args


def players(path, device):
    """The commands that play a file: [aplay], or [decoder, aplay] with the decoder piped in."""
    if path.lower().endswith('.mp3'):
        # mpg123 decodes to what the DL1 path takes as is: S16_LE, stereo (mono is doubled), 48 kHz.
        return [['mpg123', '-q', '-s', '-r', str(RATE), '--stereo', '-e', 's16', path],
                APLAY + ['-D', device, '-t', 'raw', '-f', 'S16_LE', '-r', str(RATE), '-c', '2', '-']]
    return [APLAY + ['-D', device, path]]


def play(path, device):
    os.makedirs(RUN, exist_ok=True)
    with open(os.path.join(RUN, 'sound.lock'), 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0  # something is already playing: skip rather than queue
        hold = os.open(HOLD, os.O_RDONLY)  # the SRAM-ring workaround, see the top of this file
        procs = []
        try:
            cmds = players(path, device)
            if len(cmds) == 2:
                procs.append(subprocess.Popen(cmds[0], stdout=subprocess.PIPE))
                procs.append(subprocess.Popen(cmds[1], stdin=procs[0].stdout))
                procs[0].stdout.close()  # aplay holds the pipe now: the decoder sees it close with it
            else:
                procs.append(subprocess.Popen(cmds[0]))
            rc = procs[-1].wait(timeout=PLAY_LIMIT)
            return rc or procs[0].wait(timeout=5)
        finally:
            # Stopped, failed or done: the players go first, the held node last (see the top).
            for p in reversed(procs):
                if p.poll() is None:
                    p.terminate()
                    try:
                        p.wait(timeout=3)
                    except subprocess.TimeoutExpired:
                        p.kill()
                        p.wait()
            os.close(hold)


def stopped(signum, frame):
    signal.signal(signal.SIGTERM, signal.SIG_IGN)  # a second one must not cut the cleanup short
    raise SystemExit(128 + signum)  # unwinds through play()'s cleanup


def main(argv):
    cmd = argv[1] if len(argv) > 1 else 'beep'
    if cmd == 'beep':
        hz = int(argv[2]) if len(argv) > 2 else 880
        ms = int(argv[3]) if len(argv) > 3 else 200
        count = int(argv[4]) if len(argv) > 4 else 1
        os.makedirs(RUN, exist_ok=True)
        path = os.path.join(RUN, 'beep-%d-%d.wav' % (hz, ms))
        if not os.path.exists(path):
            tone(hz, ms, path + '.tmp')
            os.rename(path + '.tmp', path)
        for _ in range(count):
            rc = play(path, DEVICE)
            if rc:
                return rc
        return 0
    if cmd == 'play' and len(argv) > 2:
        if not os.path.isfile(argv[2]):
            raise RuntimeError('no such file: %s' % argv[2])
        if argv[2].lower().endswith('.mp3'):
            if not shutil.which('mpg123'):
                raise RuntimeError('mpg123 is not installed: MP3 needs it')
            return play(argv[2], 'plug' + DEVICE)  # already 48 kHz stereo S16: plug converts nothing
        fmt = wav_format(argv[2])
        if fmt != (RATE, 2, 2):
            # No conversion by ALSA's plug layer (see the top): the alarm falls back to its beep.
            raise RuntimeError('%s: %s; only 48 kHz 16-bit stereo WAV plays (convert it, or use MP3)' % (
                argv[2], 'not a WAV file' if fmt is None else '%d Hz, %d channel(s), %d-bit' % (
                    fmt[0], fmt[1], 8 * fmt[2])))
        return play(argv[2], DEVICE)
    if cmd in ('say', 'render', 'prepare') and len(argv) > 2:
        voice, flags, args = speech_options(argv[2:])
        out = None
        if cmd == 'render' and args:
            out, args = args[0], args[1:]
        texts = [t.strip() for t in ' '.join(args).splitlines() if t.strip()]
        if texts and (out or cmd != 'render'):
            os.makedirs(RUN, exist_ok=True)
            if cmd == 'prepare':
                prepare(voice, texts, 'keep' in flags)
                return 0
            if 'ready' in flags:  # never waits: the clips there are, up to the first missing one
                missing = [i for i, t in enumerate(texts) if not cached(voice, t)]
                texts = texts[:missing[0]] if missing else texts
                if not texts:
                    return 4
            else:
                prepare(voice, texts)
            path = out or os.path.join(RUN, 'say-%d.wav' % os.getpid())
            write_wav(path, join(voice, texts))
            if out:
                return 0
            try:
                return play(path, DEVICE)
            finally:
                os.remove(path)
    if cmd == 'volume':
        print(volume(argv[2] if len(argv) > 2 else None))
        return 0
    print(__doc__.split('\n\n')[1], file=sys.stderr)
    return 2


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, stopped)
    try:
        sys.exit(main(sys.argv))
    except (OSError, RuntimeError, subprocess.SubprocessError) as e:
        print('penguin-sound: %s' % e, file=sys.stderr)
        sys.exit(1)
