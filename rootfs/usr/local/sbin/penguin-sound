#!/usr/bin/python3
"""penguin-sound — the speaker, safely.

    penguin-sound beep [HZ [MS [COUNT]]]   a tone (default 880 Hz, 200 ms, once)
    penguin-sound play FILE                an MP3 (mpg123) or a 48 kHz 16-bit stereo WAV; SIGTERM stops it
    penguin-sound say [-v VOICE] TEXT...   TEXT spoken by espeak-ng (VOICE: en, pt-br, ...)
    penguin-sound volume [PERCENT]         show or set the amplifier volume (0-100)

Playback is the MediaTek AFE's DL1 path, card 0 device 23 (S16_LE, stereo, 48 kHz). Two rules from
TECHO5's docs/hardware.md, both found the hard way on cronos:
  - another AFE PCM node must be held open while device 23 plays: with none, the driver puts its ring
    in the AFE's SRAM and the first copy into it panics the kernel. /dev/snd/pcmC0D1c (an unused
    capture) is held open, unconfigured, for the whole playback.
  - never touch Ext_Speaker_Amp_Switch: on cronos it resets the amplifier, which then stays silent
    until a reboot. Volume goes through the amplifier's own digital volume only.

A third rule, found on this unit (v0.3.0): no sample rate or channel conversion by ALSA's plug
layer. A 22050 Hz mono WAV played through plughw:0,23 underran on every period and left a page of
an unrelated file in the page cache zeroed: most likely kernel memory written by the AFE driver
(the file on disk was intact after a reboot). So what reaches
device 23 is already S16_LE, stereo, 48 kHz: mpg123 decodes MP3 to it, speech is converted to it here,
and a WAV in any other format is refused (convert it, or use MP3).

Only one sound plays at a time: a second one, while another plays, is skipped rather than queued.
SIGTERM stops a playback cleanly (the players first, the held capture node last), which is how
penguin-ui stops the alarm's music.

say synthesizes with espeak-ng (22050 Hz mono), converts that to 48 kHz stereo into
/run/penguin/say.wav, and plays it like a beep. VOICE is an espeak-ng voice; without -v it is
SPEAK_VOICE from the settings (defaults.conf, then /data/penguin/settings.conf), else en. penguin-ui
says the time and the weather with it (penguin-weather speech) after an alarm.
"""
import fcntl
import math
import os
import re
import shutil
import signal
import struct
import subprocess
import sys
import wave
from array import array
from itertools import chain, count, cycle, islice, repeat
from operator import add, floordiv, mul, sub

HOLD = '/dev/snd/pcmC0D1c'
DEVICE = 'hw:0,23'
RUN = '/run/penguin'
RATE = 48000
PLAY_LIMIT = 3600  # s: a stuck player must not hold the speaker forever
APLAY = ['aplay', '-q', '--period-size=768', '--buffer-size=3072']
# Volume controls by amplifier, as the kernel names them (cat /sys/bus/i2c/devices/2-*/name).
VOLUME_CONTROLS = ('Master TAS5805m Playback Volume A',  # TI TAS5805M
                   'Digital Volume A')                    # Maxim MAX98396
MAX98396_SAFE_MODE = 'Speaker Safe Mode A'  # a ~30 dB power cap the MAX98396 comes up with
SETTINGS = ('/etc/penguin/defaults.conf', '/data/penguin/settings.conf')
SAY_LIMIT = 60  # s: espeak-ng takes well under a second for a sentence


def amixer(*args, check=False):
    r = subprocess.run(['amixer', '-q', '-D', 'hw:0'] + list(args), capture_output=True, text=True, timeout=5)
    if check and r.returncode:
        raise RuntimeError(r.stderr.strip())
    return r


def control_range(name):
    """(min, max, current) of an integer mixer control, or None when the card has no such control."""
    r = subprocess.run(['amixer', '-D', 'hw:0', 'cget', 'name=' + name], capture_output=True, text=True, timeout=5)
    if r.returncode:
        return None
    lo = hi = cur = None
    for part in r.stdout.replace(',', ' ').split():
        if part.startswith('min='):
            lo = int(part[4:])
        elif part.startswith('max='):
            hi = int(part[4:])
        elif part.startswith('values='):
            cur = int(part[7:])
    return None if hi is None else (lo or 0, hi, cur)


def volume(percent=None):
    for name in VOLUME_CONTROLS:
        rng = control_range(name)
        if rng is None:
            continue
        lo, hi, cur = rng
        if percent is None:
            return round(100 * (cur - lo) / (hi - lo)) if cur is not None else None
        percent = max(0, min(100, int(percent)))
        amixer('cset', 'name=' + name, str(lo + round((hi - lo) * percent / 100)), check=True)
        if name == 'Digital Volume A' and control_range(MAX98396_SAFE_MODE):
            amixer('cset', 'name=' + MAX98396_SAFE_MODE, '0')
        return percent
    raise RuntimeError('no known amplifier volume control on card 0')


def tone(hz, ms, path):
    rate, n = 48000, int(48000 * ms / 1000)
    ramp = max(1, min(n // 4, 480))  # 10 ms fades: no clicks
    frames = bytearray()
    for i in range(n):
        env = min(1.0, i / ramp, (n - i) / ramp)
        v = int(0.25 * 32767 * env * math.sin(2 * math.pi * hz * i / rate))
        frames += struct.pack('<hh', v, v)
    with wave.open(path, 'wb') as w:
        w.setnchannels(2)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(bytes(frames))


def settings():
    values = {}
    for path in SETTINGS:
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                text = f.read()
        except OSError:
            continue
        for line in text.splitlines():
            m = re.match(r'^([A-Z_][A-Z0-9_]*)=("?)(.*?)\2\s*(#.*)?$', line)
            if m:
                values[m.group(1)] = m.group(3)
    return values


def device_format(src, dst):
    """A 16-bit WAV converted to what device 23 takes (S16_LE, stereo, 48 kHz): linear interpolation,
    mono computed once for both sides. Built from map() and itertools, which loop in C: about two
    seconds on the unit for ten seconds of speech (a plain Python loop over the samples took five)."""
    with wave.open(src, 'rb') as w:
        channels, width, rate, n = w.getnchannels(), w.getsampwidth(), w.getframerate(), w.getnframes()
        raw = w.readframes(n)
    if width != 2 or channels not in (1, 2) or not rate:
        raise RuntimeError('%s: not a 16-bit mono or stereo WAV' % src)
    samples = array('h')
    samples.frombytes(raw[:len(raw) - len(raw) % (2 * channels)])
    if sys.byteorder == 'big':
        samples.byteswap()
    n = len(samples) // channels
    n_out = n * RATE // rate
    # Output sample i sits at input position i * rate / RATE: index j and fraction f (in 1/RATE). Both
    # repeat every RATE/g outputs, the index then advanced by rate/g inputs.
    g = math.gcd(rate, RATE)
    p_in, p_out = rate // g, RATE // g
    base_j = [k * rate // RATE for k in range(p_out)]
    base_f = [k * rate % RATE for k in range(p_out)]

    def index(shift=0):
        steps = chain.from_iterable(repeat(c * p_in + shift, p_out) for c in count())
        return islice(map(add, cycle(base_j), steps), n_out)

    out = array('h', bytes(4 * n_out))
    for c in range(channels):
        chan = samples[c::channels]
        chan.extend(chan[-1:] * 2)  # the last sample repeated: index + 1 is always there
        a = list(map(chan.__getitem__, index()))
        b = map(chan.__getitem__, index(1))
        slope = map(floordiv, map(mul, map(sub, b, a), islice(cycle(base_f), n_out)), repeat(RATE))
        conv = array('h', map(add, a, slope))
        for side in ((0, 1) if channels == 1 else (c,)):  # mono: computed once, on both sides
            out[side::2] = conv
    if sys.byteorder == 'big':
        out.byteswap()
    with wave.open(dst, 'wb') as w:
        w.setnchannels(2)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(out.tobytes())


def wav_format(path):
    """(rate, channels, sample width) of a WAV file; None when it cannot be read as one."""
    try:
        with wave.open(path, 'rb') as w:
            return w.getframerate(), w.getnchannels(), w.getsampwidth()
    except (OSError, EOFError, wave.Error):
        return None


def speech(text, voice, path):
    """TEXT spoken by espeak-ng into a WAV file in the device's format (device_format), written
    atomically."""
    if not shutil.which('espeak-ng'):
        raise RuntimeError('espeak-ng is not installed: say needs it')
    tmp = '%s.%d.tmp' % (path, os.getpid())
    try:
        # -w, not --stdout: its WAV header then holds the real length, not a streaming 2 GB. The text
        # goes on stdin, as it may start with a dash. espeak-ng reports a file it cannot write on
        # stderr only, with exit status 0.
        r = subprocess.run(['espeak-ng', '-v', voice, '-w', tmp], input=text.encode(), capture_output=True,
                           timeout=SAY_LIMIT)
        why = (r.stderr or r.stdout).decode(errors='replace').strip()
        if r.returncode or why or not os.path.isfile(tmp) or os.path.getsize(tmp) <= 44:  # 44: header only
            raise RuntimeError('espeak-ng -v %s: %s' % (voice, why or 'exit %d, no sound' % r.returncode))
        device_format(tmp, tmp + '.48k')
        os.replace(tmp + '.48k', path)
    finally:
        for f in (tmp, tmp + '.48k'):
            if os.path.exists(f):
                os.remove(f)


def players(path, device):
    """The commands that play a file: [aplay], or [decoder, aplay] with the decoder piped in."""
    if path.lower().endswith('.mp3'):
        # mpg123 decodes to what the DL1 path takes as is: S16_LE, stereo (mono is doubled), 48 kHz.
        return [['mpg123', '-q', '-s', '-r', str(RATE), '--stereo', '-e', 's16', path],
                APLAY + ['-D', device, '-t', 'raw', '-f', 'S16_LE', '-r', str(RATE), '-c', '2', '-']]
    return [APLAY + ['-D', device, path]]


def play(path, device):
    os.makedirs(RUN, exist_ok=True)
    with open(os.path.join(RUN, 'sound.lock'), 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0  # something is already playing: skip rather than queue
        hold = os.open(HOLD, os.O_RDONLY)  # the SRAM-ring workaround, see the top of this file
        procs = []
        try:
            cmds = players(path, device)
            if len(cmds) == 2:
                procs.append(subprocess.Popen(cmds[0], stdout=subprocess.PIPE))
                procs.append(subprocess.Popen(cmds[1], stdin=procs[0].stdout))
                procs[0].stdout.close()  # aplay holds the pipe now: the decoder sees it close with it
            else:
                procs.append(subprocess.Popen(cmds[0]))
            rc = procs[-1].wait(timeout=PLAY_LIMIT)
            return rc or procs[0].wait(timeout=5)
        finally:
            # Stopped, failed or done: the players go first, the held node last (see the top).
            for p in reversed(procs):
                if p.poll() is None:
                    p.terminate()
                    try:
                        p.wait(timeout=3)
                    except subprocess.TimeoutExpired:
                        p.kill()
                        p.wait()
            os.close(hold)


def stopped(signum, frame):
    signal.signal(signal.SIGTERM, signal.SIG_IGN)  # a second one must not cut the cleanup short
    raise SystemExit(128 + signum)  # unwinds through play()'s cleanup


def main(argv):
    cmd = argv[1] if len(argv) > 1 else 'beep'
    if cmd == 'beep':
        hz = int(argv[2]) if len(argv) > 2 else 880
        ms = int(argv[3]) if len(argv) > 3 else 200
        count = int(argv[4]) if len(argv) > 4 else 1
        os.makedirs(RUN, exist_ok=True)
        path = os.path.join(RUN, 'beep-%d-%d.wav' % (hz, ms))
        if not os.path.exists(path):
            tone(hz, ms, path + '.tmp')
            os.rename(path + '.tmp', path)
        for _ in range(count):
            rc = play(path, DEVICE)
            if rc:
                return rc
        return 0
    if cmd == 'play' and len(argv) > 2:
        if not os.path.isfile(argv[2]):
            raise RuntimeError('no such file: %s' % argv[2])
        if argv[2].lower().endswith('.mp3'):
            if not shutil.which('mpg123'):
                raise RuntimeError('mpg123 is not installed: MP3 needs it')
            return play(argv[2], 'plug' + DEVICE)  # already 48 kHz stereo S16: plug converts nothing
        fmt = wav_format(argv[2])
        if fmt != (RATE, 2, 2):
            # No conversion by ALSA's plug layer (see the top): the alarm falls back to its beep.
            raise RuntimeError('%s: %s; only 48 kHz 16-bit stereo WAV plays (convert it, or use MP3)' % (
                argv[2], 'not a WAV file' if fmt is None else '%d Hz, %d channel(s), %d-bit' % (
                    fmt[0], fmt[1], 8 * fmt[2])))
        return play(argv[2], DEVICE)
    if cmd == 'say' and len(argv) > 2:
        args, voice = argv[2:], None
        if args[0] == '-v' and len(args) > 1:
            args, voice = args[2:], args[1]
        text = ' '.join(args).strip()
        if text:
            os.makedirs(RUN, exist_ok=True)
            path = os.path.join(RUN, 'say.wav')
            speech(text, voice or settings().get('SPEAK_VOICE') or 'en', path)
            return play(path, DEVICE)
    if cmd == 'volume':
        print(volume(argv[2] if len(argv) > 2 else None))
        return 0
    print(__doc__.split('\n\n')[1], file=sys.stderr)
    return 2


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, stopped)
    try:
        sys.exit(main(sys.argv))
    except (OSError, RuntimeError, subprocess.SubprocessError) as e:
        print('penguin-sound: %s' % e, file=sys.stderr)
        sys.exit(1)
