#!/bin/sh
# penguin — echo-penguin on the unit, from an SSH session or the USB console.
#
#   penguin status              kernel, services, containers, temperature, memory, disk, slots
#   penguin logs [what] [-f]    supervisor (default) | docker | boot | firewall
#   penguin settings            effective settings (defaults + /data/penguin/settings.conf)
#   penguin set KEY VALUE       write one setting to /data/penguin/settings.conf
#   penguin restart             restart the supervisor (dockerd keeps running)
#   penguin firewall            apply techo5-firewall again (after changing LAN_PORTS or DOCKER_LAN)
#   penguin ssh [status]        SSH: on or off, who may connect, the authorized keys
#   penguin ssh on | off        start or stop SSH (off: USB console and the screen still work)
#   penguin ssh allow here | ADDR...   add computers (MAC / IP / network); then only those connect
#   penguin ssh deny ADDR...    remove computers from that list
#   penguin ssh allow any       clear the list: any device on the Wi-Fi may try (a key is still needed)
#   penguin cleanup [--slot] [--yes]   list what is no longer needed; --yes removes it (--slot: old slot too)
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
. /lib/penguin.sh
p_settings

status() {
	echo "release:   $(cat /etc/techo5-release 2>/dev/null)"
	echo "kernel:    $(uname -r) ($(p_docker_kernel && echo 'docker kernel' || echo 'safe kernel, no containers'))"
	echo "slot:      $(cat /run/techo5/slot 2>/dev/null || echo 'none (rescue)')"
	echo "docker:    $(cat /run/penguin/docker 2>/dev/null || echo '?') (DOCKER=$DOCKER)"
	echo "address:   $(ip -4 addr show wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.\/]*\).*/\1/p' | head -1)"
	for p in techo5 dockerd containerd dropbear wpa_supplicant ntpd watchdog; do
		printf '  %-15s %s\n' "$p" "$(pidof $p >/dev/null && echo running || echo -)"
	done
	if [ "$(cat /run/penguin/docker 2>/dev/null)" = docker ]; then
		docker ps -a --format '  container {{.Names}}: {{.Status}}' 2>/dev/null
	fi
	echo "temp:      $(p_temp)C (warn $TEMP_WARN, crit $TEMP_CRIT)"
	echo "cpus:      $(cat /sys/devices/system/cpu/online)  load $(cut -d' ' -f1-3 /proc/loadavg)"
	free -m | sed 's/^/  /'
	df -h /data /store 2>/dev/null | sed 's/^/  /'
	STORE=/store slotctl status 2>/dev/null | sed 's/^/  /'
}

# set_setting KEY VALUE: one setting into /data/penguin/settings.conf.
set_setting() {
	mkdir -p $PENGUIN_DATA
	touch $PENGUIN_DATA/settings.conf
	sed -i "/^$1=/d" $PENGUIN_DATA/settings.conf
	printf '%s="%s"\n' "$1" "$2" >> $PENGUIN_DATA/settings.conf
}

firewall_apply() { /usr/local/sbin/techo5-firewall > /data/techo5-linux/firewall.log 2>&1; tail -2 /data/techo5-linux/firewall.log | sed -n '1p'; }

# The computer this command runs for, when it runs over SSH: its address, and its MAC from the ARP
# table (on the same Wi-Fi network only).
client_ip() { echo "${SSH_CONNECTION%% *}"; }
client_mac() { awk -v ip="$(client_ip)" '$1 == ip {print $4}' /proc/net/arp | head -1; }

ssh_keys() {
	python3 - /data/misc/techo5/ssh/authorized_keys <<'PY'
import base64, hashlib, sys
try:
    lines = open(sys.argv[1]).read().splitlines()
except OSError:
    lines = []
n = 0
for line in lines:
    parts = line.split()
    for i, p in enumerate(parts):
        if p.startswith(('ssh-', 'ecdsa-', 'sk-')) and i + 1 < len(parts):
            fp = base64.b64encode(hashlib.sha256(base64.b64decode(parts[i + 1])).digest()).decode().rstrip('=')
            n += 1
            print('  %d. %s SHA256:%s  %s' % (n, p, fp, ' '.join(parts[i + 2:]) or '(no comment)'))
            break
print('  %d key(s) in %s' % (n, sys.argv[1]))
PY
}

ssh_status() {
	echo "SSH:       ${SSH:-on} (dropbear $(pidof dropbear >/dev/null && echo running || echo 'not running'), keys only)"
	echo "allowed:   ${SSH_ALLOW:-any device on the Wi-Fi network (with an authorized key)}"
	[ -n "${SSH_CONNECTION:-}" ] && echo "you:       $(client_ip) $(client_mac)"
	echo "firewall:  $(grep -m1 'iptables-legacy:' /data/techo5-linux/firewall.log 2>/dev/null | sed 's/^techo5-firewall: //')"
	echo "keys:"
	ssh_keys
}

# ssh_allow_check LIST: whether this SSH session's computer is in LIST (by MAC, address or network).
ssh_allow_check() {
	[ -n "${SSH_CONNECTION:-}" ] || return 0
	python3 - "$(client_ip)" "$(client_mac)" "$@" <<'PY'
import ipaddress, sys
ip, mac, entries = sys.argv[1], sys.argv[2].lower(), sys.argv[3:]
for e in entries:
    if e.lower() == mac and mac:
        sys.exit(0)
    try:
        if ipaddress.ip_address(ip) in ipaddress.ip_network(e, strict=False):
            sys.exit(0)
    except ValueError:
        pass
sys.exit(1)
PY
}

ssh_cmd() {
	case "${1:-status}" in
	status) ssh_status;;
	on)
		set_setting SSH on; SSH=on
		firewall_apply
		. /lib/techo5-lib.sh 2>/dev/null; log() { p_log ssh "$*"; }
		p_ssh; sleep 1
		pidof dropbear >/dev/null && echo "SSH is on" || { echo "SSH did not start (penguin logs boot)" >&2; exit 1; }
		;;
	off)
		set_setting SSH off; SSH=off
		firewall_apply
		echo "SSH is off: port 22 closed. Turn it back on with 'penguin ssh on' on the USB console, or on the screen (Network & SSH)."
		[ -n "${SSH_CONNECTION:-}" ] && echo "This session ends in 2 s."
		# Detached, so this message reaches an SSH session before its dropbear goes.
		setsid sh -c 'sleep 2; killall dropbear' >/dev/null 2>&1 &
		;;
	allow|deny)
		verb=$1; shift
		force=
		[ "${1:-}" = --force ] && { force=1; shift; }
		[ $# -ge 1 ] || { echo "usage: penguin ssh allow here | ADDR... | any; penguin ssh deny ADDR...   (MAC, IPv4/IPv6 address or network)" >&2; exit 2; }
		if [ $verb = allow ] && [ "$1" = any ]; then
			set_setting SSH_ALLOW ""; SSH_ALLOW=
			firewall_apply
			echo "SSH: any device on the Wi-Fi network may connect (an authorized key is still required)"
			return
		fi
		list=
		for a in "$@"; do
			if [ "$a" = here ]; then
				[ -n "${SSH_CONNECTION:-}" ] || { echo "'here' only works in an SSH session" >&2; exit 2; }
				# The MAC: an address from DHCP can go to another device later. The address only
				# when there is no MAC to see (a VPN, a routed network).
				m=$(client_mac)
				list="$list ${m:-$(client_ip)}"
				continue
			fi
			if echo "$a" | grep -qiE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
				list="$list $(echo "$a" | tr A-F a-f)"
			elif python3 -c "import ipaddress,sys; ipaddress.ip_network(sys.argv[1], strict=False)" "$a" 2>/dev/null; then
				list="$list $a"
			else
				echo "'$a' is not a MAC address, an IP address or a network" >&2; exit 2
			fi
		done
		if [ $verb = allow ]; then
			list="$SSH_ALLOW $list"
		else
			keep=
			for a in $SSH_ALLOW; do
				case " $list " in *" $a "*) ;; *) keep="$keep $a";; esac
			done
			list=$keep
		fi
		list=$(echo $list | tr ' ' '\n' | awk 'NF && !seen[$0]++' | tr '\n' ' ' | sed 's/ $//')
		if [ $verb = deny ] && [ -z "$list" ]; then
			echo "refused: that would empty the list, which opens SSH to any device; use 'penguin ssh allow any' for that" >&2
			exit 1
		fi
		if [ -z "$force" ] && ! ssh_allow_check $list; then
			echo "refused: this session's computer ($(client_ip) $(client_mac)) would not be in: $list" >&2
			echo "add 'here', or use --force (then only the USB console or the screen can undo it)" >&2
			exit 1
		fi
		set_setting SSH_ALLOW "$list"; SSH_ALLOW=$list
		firewall_apply
		echo "SSH: only $list may connect"
		;;
	keys) ssh_keys;;
	*) echo "usage: penguin ssh [status | on | off | allow here|ADDR...|any | deny ADDR... | keys]" >&2; exit 2;;
	esac
}

human_kb() {
	awk -v k="$1" 'BEGIN { if (k >= 1048576) printf "%.1f GB", k / 1048576; else if (k >= 1024) printf "%.1f MB", k / 1024; else printf "%d KB", k }'
}

data_free() { df -k /data | awk 'NR == 2 {print $4}'; }

# cleanup [--slot] [--yes]: what the unit no longer needs. Without --yes it only lists it.
cleanup() {
	yes= slot=
	for a in "$@"; do
		case "$a" in
		--yes) yes=1;;
		--slot) slot=1;;
		*) echo "usage: penguin cleanup [--slot] [--yes]" >&2; exit 2;;
		esac
	done
	total=0 free0=$(data_free)
	# item <KB> <what>: one line of the list.
	item() { total=$((total + $1)); printf '  %9s  %s\n' "$(human_kb "$1")" "$2"; }
	[ -n "$yes" ] && echo "removing:" || echo "no longer needed (penguin cleanup --yes removes it):"

	# Root filesystem tarballs: an installed one lives on in its slot, and the computer that built
	# it keeps a copy.
	for f in /data/media/0/Download/*-rootfs-*.tar.gz /data/techo5-linux/*-rootfs-*.tar.gz; do
		[ -f "$f" ] || continue
		item "$(du -sk "$f" | cut -f1)" "$f"
		[ -n "$yes" ] && rm -f "$f"
	done

	# Files tried out with a bind mount over the read-only root, unless one is still mounted.
	for f in $PENGUIN_DATA/*.test; do
		[ -f "$f" ] || continue
		n=$(basename "$f" .test)
		for t in /usr/local/bin/$n /usr/local/sbin/$n /lib/$n; do
			[ "$f" -ef "$t" ] && continue 2
		done
		item "$(du -sk "$f" | cut -f1)" "$f (a test file)"
		[ -n "$yes" ] && rm -f "$f"
	done

	if [ "$(cat /run/penguin/docker 2>/dev/null)" = docker ] && docker info >/dev/null 2>&1; then
		# Stopped containers no compose project owns: one-off docker run and failed builds. A
		# project's stay for docker compose start.
		for id in $(docker ps -aq --filter status=exited --filter status=created); do
			info=$(docker container inspect --size -f '{{.SizeRw}} {{index .Config.Labels "com.docker.compose.project"}} {{.Name}} {{.Config.Image}}' "$id") || continue
			set -- $info
			[ $# -eq 3 ] || continue
			case "$3" in sha256:*) img=$(echo "${3#sha256:}" | cut -c1-12);; *) img=$3;; esac
			item $(($1 / 1024)) "container ${2#/} ($img, stopped)"
			[ -n "$yes" ] && docker rm "$id" >/dev/null
		done
		n=$(docker images -qf dangling=true | wc -l)
		[ "$n" -gt 0 ] && printf '  %9s  %s\n' '' "$n untagged image(s) left by rebuilds, and the build cache"
		if [ -n "$yes" ]; then
			# Again while it deletes: an image whose child went is only untagged and unused now.
			for i in 1 2 3 4; do
				docker image prune -f | grep -q '^deleted:' || break
			done
			docker builder prune -f >/dev/null 2>&1
		fi
	fi

	b=$(cat /run/techo5/slot 2>/dev/null)
	case "$b" in a) o=b;; b) o=a;; *) o=;; esac
	if [ -n "$o" ] && [ -d /store/slots/$o ]; then
		rel=$(cat /store/slots/$o/etc/techo5-release 2>/dev/null | cut -d' ' -f1-3)
		if [ -z "$slot" ]; then
			echo "kept: slot $o ($rel), the way back if slot $b fails; --slot removes it (frees /store only)"
		elif [ "$(cat /store/active 2>/dev/null)" != "$b" ] || [ "$(cat /store/slots/$b.state 2>/dev/null)" != good ]; then
			echo "kept: slot $o, since slot $b is not yet the good, active one (slotctl status)"
		else
			item "$(du -sk /store/slots/$o | cut -f1)" "slot $o: $rel (on /store; no way back to it)"
			if [ -n "$yes" ]; then
				STORE=/store slotctl rw >/dev/null &&
					rm -rf /store/slots/$o /store/slots/$o.state
				sync
				STORE=/store slotctl ro >/dev/null
				# The boot layer, where installed, must not pick the slot either (3: no boot layer).
				bootctl -q mark-bad $o 2>/dev/null
			fi
		fi
	fi

	if [ $total -eq 0 ] && [ -z "${n#0}" ]; then
		echo "  nothing"
	elif [ -n "$yes" ]; then
		echo "freed on /data: $(human_kb $(($(data_free) - free0)))   (free now: $(human_kb $(data_free)))"
	else
		echo "total: $(human_kb $total)"
	fi
}

case "${1:-status}" in
status) status;;
ssh) shift; ssh_cmd "$@";;
cleanup) shift; cleanup "$@";;
logs)
	what=${2:-supervisor}; follow=
	[ "${3:-}" = -f ] || [ "${2:-}" = -f ] && follow=1
	[ "$what" = -f ] && what=supervisor
	case "$what" in
	boot) f=/run/boot.log;;
	firewall) f=/data/techo5-linux/firewall.log;;
	supervisor|docker) f=$PENGUIN_LOGS/$what.log;;
	*) echo "logs: supervisor | docker | boot | firewall" >&2; exit 2;;
	esac
	if [ -n "$follow" ]; then exec tail -n 50 -f "$f"; else tail -n 100 "$f"; fi
	;;
settings) (set -a; . /etc/penguin/defaults.conf; [ -r $PENGUIN_DATA/settings.conf ] && . $PENGUIN_DATA/settings.conf
	sed -n 's/^\([A-Z_][A-Z0-9_]*\)=.*/\1/p' /etc/penguin/defaults.conf | while read -r k; do eval "echo $k=\"\$$k\""; done);;
set)
	[ -n "${2:-}" ] && [ $# -ge 3 ] || { echo "usage: penguin set KEY VALUE" >&2; exit 2; }
	case "$2" in *[!A-Z0-9_]*|[!A-Z_]*) echo "invalid setting name $2" >&2; exit 2;; esac
	grep -q "^$2=" /etc/penguin/defaults.conf || { echo "unknown setting $2 (see penguin settings)" >&2; exit 2; }
	# settings.conf is sourced by the shell as root at boot, each value inside double quotes: a
	# quote, $, a backquote or a backslash in a value would run as code there. Control characters
	# (a newline would start another setting) are refused too.
	case "$3" in *[\"\$\`\\]*) echo "a setting's value cannot contain \" \$ \` or \\" >&2; exit 2;; esac
	[ "$(printf '%s' "$3" | tr -d '[:cntrl:]')" = "$3" ] || { echo "a setting's value cannot contain control characters" >&2; exit 2; }
	set_setting "$2" "$3"
	echo "$2=$3 (takes effect after: penguin restart; firewall settings: penguin firewall)"
	;;
restart) killall techo5 2>/dev/null; echo "supervisor restarting (init starts it again)";;
firewall) /usr/local/sbin/techo5-firewall;;
*) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2;;
esac
