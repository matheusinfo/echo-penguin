# Pinned inputs for echo-penguin. Sourced by every script in scripts/.
# Paths are relative to the echo-penguin checkout unless absolute.

# TECHO5: boot chain, rescue initramfs, slot store, installer (used as is, never modified).
TECHO5_URL=https://github.com/HuskerMinion/techo5
TECHO5_COMMIT=50d59e87

# LineageOS cronos kernel: the commit the LineageOS 2026-09-04 boot image was built from
# (`uname -r` = 4.9.337-g8d928c5176cc). It lives on the lineage-18.1 branch, not cronos/lineage-18.1.
KERNEL_URL=https://github.com/amazon-oss/android_kernel_amazon_mt8163
KERNEL_BRANCH=lineage-18.1
KERNEL_COMMIT=8d928c5176cc
KERNEL_RELEASE=4.9.337-g8d928c5176cc

# MT7668 Wi-Fi driver, the source LineageOS builds mt76x8_wlan.ko from. 214defc is the last commit
# before the 2026-09-04 build; rebuilt against the stock kernel it gives the same import table
# (203 symbols, same CRCs) as the binary in the LineageOS zip.
WLAN_URL=https://github.com/amazon-oss/android_kernel_amazon_mt76x8-wifi
WLAN_COMMIT=214defc

# Arm GNU toolchain named by TECHO5's build-kernel.sh (newer GCC breaks this 4.9 tree).
TOOLCHAIN_URL=https://developer.arm.com/-/media/Files/downloads/gnu-a/8.3-2019.03/binrel/gcc-arm-8.3-2019.03-x86_64-aarch64-linux-gnu.tar.xz
TOOLCHAIN_DIR=gcc-arm-8.3-2019.03-x86_64-aarch64-linux-gnu

# Everything fetched and built lives outside this repository, in PENGUIN_BUILD (default: the sibling
# folder ../echo-penguin-build): the TECHO5 checkout, kernel trees, toolchain, images.
PENGUIN_BUILD=${PENGUIN_BUILD:-../echo-penguin-build}
WORK=${WORK:-$PENGUIN_BUILD/work}
OUT=${OUT:-$WORK/out}

# Screen console, appended to the kernel command line by build-boot.sh. The panel's framebuffer is
# 480x960 portrait with its origin at the bottom-left of the unit as it stands (measured on cronos,
# 2026-10-31), so text is turned 90 degrees clockwise (rotate:1) to read in landscape. Font: 12x22
# gives 80x21 characters on the 960x480 screen; 10x18 (96x26) and 8x16 (120x30) are built in too.
# consoleblank=0: the console never blanks itself (the kernel's default is after 10 idle minutes).
SCREEN_CMDLINE=${SCREEN_CMDLINE-"fbcon=rotate:1 fbcon=font:SUN12x22 consoleblank=0"}
