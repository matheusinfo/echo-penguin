# Pinned inputs for echo-penguin. Sourced by every script in scripts/.
# Paths are relative to the echo-penguin checkout unless absolute.

# TECHO5: boot chain, rescue initramfs, slot store, installer (used as is, never modified).
TECHO5_URL=https://github.com/HuskerMinion/techo5
TECHO5_COMMIT=50d59e87

# LineageOS cronos kernel: the commit the LineageOS 2026-09-04 boot image was built from
# (`uname -r` = 4.9.337-g8d928c5176cc). It lives on the lineage-18.1 branch, not cronos/lineage-18.1.
KERNEL_URL=https://github.com/amazon-oss/android_kernel_amazon_mt8163
KERNEL_BRANCH=lineage-18.1
KERNEL_COMMIT=8d928c5176cc
KERNEL_RELEASE=4.9.337-g8d928c5176cc

# MT7668 Wi-Fi driver, the source LineageOS builds mt76x8_wlan.ko from. 214defc is the last commit
# before the 2026-09-04 build; rebuilt against the stock kernel it gives the same import table
# (203 symbols, same CRCs) as the binary in the LineageOS zip.
WLAN_URL=https://github.com/amazon-oss/android_kernel_amazon_mt76x8-wifi
WLAN_COMMIT=214defc

# Arm GNU toolchain named by TECHO5's build-kernel.sh (newer GCC breaks this 4.9 tree).
TOOLCHAIN_URL=https://developer.arm.com/-/media/Files/downloads/gnu-a/8.3-2019.03/binrel/gcc-arm-8.3-2019.03-x86_64-aarch64-linux-gnu.tar.xz
TOOLCHAIN_DIR=gcc-arm-8.3-2019.03-x86_64-aarch64-linux-gnu

# Everything fetched and built lives in PENGUIN_BUILD (default: build/, git-ignored): the TECHO5
# checkout, kernel trees, toolchain, images. All of it can be fetched and built again.
PENGUIN_BUILD=${PENGUIN_BUILD:-build}
WORK=${WORK:-$PENGUIN_BUILD/work}
OUT=${OUT:-$WORK/out}

# Extra kernel command line for build-boot.sh (empty by default). Keep it empty or tiny: the
# bootloader passes ~1012 of its 1024 bytes already, and a longer line hangs the unit at the boot
# logo on a warm reboot (2026-10-31). The screen console's settings live in kernel/ instead.
SCREEN_CMDLINE=${SCREEN_CMDLINE-}

# Piper, the offline neural voice of the alarm's spoken greeting and of the clock's. Alpine packages
# it only in edge/testing, so it is not installed among the root's v3.24 packages: build-piper.sh takes
# piper_exe and every library it loads (onnxruntime, ICU, abseil, edge's own musl...) into a
# self-contained tree, /usr/lib/piper, run by edge's musl loader. Edge moves on: when these versions
# leave the mirror, build-piper.sh says so, and they are updated here. The voice: pt_BR "faber"
# (medium), dataset CC0, fine-tuned from the en_US lessac voice.
PIPER_REPO=https://dl-cdn.alpinelinux.org/alpine/edge
PIPER_TTS=piper-tts-1.7.0-r0
PIPER_TTS_SHA256=e9b5c3c02ae0246f60e99b16b34abe24ab354c1f505ab7fbc155b4e1f67e725e
PIPER_LIB=libpiper-1.7.0-r0
PIPER_VOICE_NAME=pt_BR-faber-medium
PIPER_VOICE_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main/pt/pt_BR/faber/medium
PIPER_VOICE_SHA256=858555e3a064209c57088fe6bd70c4c3dc54d03eaa00c45d5ecaf43a33f95aa7
PIPER_VOICE_JSON_SHA256=7e694de195ae3fc36dd732c445eb04fb49b649854893cb5506b978f0d50a1d6f
